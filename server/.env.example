# ── Runtime (Railway sets PORT automatically) ──
PORT=5000
NODE_ENV=production

# PostgreSQL — on Railway, link the Postgres plugin; it injects DATABASE_URL.
# Local example:
DATABASE_URL=postgresql://cargotrader:cargotrader_dev@127.0.0.1:5432/afritrade?schema=public

# JWT — use long random secrets in production (32+ chars)
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_EXPIRES_IN=7d

# Frontend origin(s) for CORS + email/Stripe return URLs
# Set CLIENT_URL to your Vercel production URL (https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173
# Optional comma-separated extras (preview deployments, custom domains)
# CLIENT_URLS=https://cargotrader.vercel.app,https://www.yourdomain.com

# Never enable these in production
WIPE_DB=false
ALLOW_DESTRUCTIVE_OPS=false
# PLATFORM_ADMIN_EMAILS=ops@yourdomain.com

# Carrier auto-tracking
TRACKING_PROVIDER=mock
TRACKING_POLL_MS=120000
# SHIPPO_API_KEY=
# EASYPOST_API_KEY=

# Google Sign-In — OAuth 2.0 Web Client ID
# Authorized JavaScript origins: Vercel URL + http://localhost:5173
GOOGLE_CLIENT_ID=

# Email (required in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CargoTrader <noreply@cargotrader.app>
SUPPORT_EMAIL=support@cargotrader.app
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_AUTOMATIC_TAX=false
STRIPE_PRODUCT_PROFESSIONAL=
STRIPE_PRODUCT_PROFESSIONAL_PLUS=
STRIPE_PRODUCT_ENTERPRISE=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=
STRIPE_PRICE_PROFESSIONAL_PLUS_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_PLUS_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
STRIPE_TRIAL_PERIOD_DAYS=7

# Flutterwave — POS Mobile Money
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_COUNTRY=CM

# Cloudinary (required in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=afritrade

# AI vision
AI_VISION_PROVIDER=auto
OPENAI_API_KEY=
AI_VISION_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
