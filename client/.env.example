# Public API origin for production (Railway). No trailing slash.
# Local Next.js leaves this unset/localhost and rewrites /api → http://localhost:5000
# Example: https://cargotrader-api-production.up.railway.app
NEXT_PUBLIC_API_URL=

# Support email shown on /contact
NEXT_PUBLIC_SUPPORT_EMAIL=support@cargotrader.app

# Google Sign-In Client ID is configured on the SERVER only
# (frontend loads it from GET /api/auth/google/config)
# Google Cloud Console → Authorized JavaScript origins must include:
#   http://localhost:5173
#   https://your-app.vercel.app
